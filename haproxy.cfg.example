# Add this backend to the HTTPS frontend routing used for fcp3.me.
# Replace 192.168.0.50 with the Docker host address.
acl host_linkedin hdr(host) -i linkedin.fcp3.me
use_backend linkedin_publisher if host_linkedin

backend linkedin_publisher
    mode http
    option httpchk GET /healthz
    http-check expect status 200
    server publisher 192.168.0.50:8080 check
