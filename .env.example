# Copy to .env and fill in. Never commit .env.
# Generates a 32-hex value: openssl rand -hex 32

BASE_URL=https://linkedin.fcp3.me
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_SCOPE=openid profile w_member_social
APP_API_KEY=
SESSION_SECRET=
DEFAULT_HASHTAGS=
FEED_SOURCES_FILE=/data/feeds.txt
FEEDS_ENABLED=1
GENERATOR_ENABLED=1
SEARXNG_URL=http://192.168.0.209:8082
TOPICS=packet analysis,network security,networking,security research,security tooling,ai tooling,quantum computing
DAILY_HOUR_WEEKDAY=10
DAILY_HOUR_WEEKEND=6
STORY_MAX_AGE_DAYS=7
DB_PATH=/data/linkedin.db
PORT=8080
POLL_SECONDS=30
USER_TIMEZONE=America/New_York
PROMO_GATE_ENABLED=1
PROMO_GATE_URL=http://192.168.0.50:11434
PROMO_GATE_MODEL=qwen2.5:7b
PROMO_GATE_TIMEOUT=60
SUMMARY_ENABLED=1
SUMMARY_URL_PRIMARY=http://192.168.0.217:11434
SUMMARY_MODEL_PRIMARY=deepseek-v4.1-flash:cloud
SUMMARY_URL_FALLBACK=http://192.168.0.50:11434
SUMMARY_MODEL_FALLBACK=qwen2.5:7b
SUMMARY_TIMEOUT=180
SUMMARY_MIN_CHARS=250
SUMMARY_MAX_CHARS=900
